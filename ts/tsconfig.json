{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "bun-types"
    ],
    "paths": {
      "@agency/agent/*": [
        "./agent/*"
      ],
      "@agency/archive/*": [
        "./archive/*"
      ],
      "@agency/support/*": [
        "./support/*"
      ],
      "@agency/policy/*": [
        "../policy/*"
      ],
      "@agency/test-support/*": [
        "../tests/ts/support/*"
      ]
    }
  },
  "include": [
    "agent",
    "archive",
    "support",
    "../tests/ts"
  ]
}
