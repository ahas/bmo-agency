{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "workflowSizeGuideline": "small",
  "disableClaudeAiConnectors": true,
  "claudeMdExcludes": ["/home/*/.claude/CLAUDE.md"],
  "skillOverrides": {
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "artifact-capabilities": "off",
    "keybindings-help": "off",
    "update-config": "off",
    "fewer-permission-prompts": "off",
    "loop": "off",
    "schedule": "off",
    "init": "off"
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "60000",
    "BASH_MAX_TIMEOUT_MS": "600000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$BMO_SOURCE_DIR\" ] || timeout 10 \"${BMO_DEPLOY_DIR:-$HOME/.local/share/bmo/deploy}/bin/bmo\" job-guard || true",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$BMO_SOURCE_DIR\" ] || exec \"${BMO_DEPLOY_DIR:-$HOME/.local/share/bmo/deploy}/bin/bmo-agency\" coworker hook",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$BMO_SOURCE_DIR\" ] || exec \"${BMO_DEPLOY_DIR:-$HOME/.local/share/bmo/deploy}/bin/bmo-agency\" coworker hook",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$BMO_SOURCE_DIR\" ] || exec \"${BMO_DEPLOY_DIR:-$HOME/.local/share/bmo/deploy}/bin/bmo-agency\" coworker hook",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$BMO_SOURCE_DIR\" ] || exec \"${BMO_DEPLOY_DIR:-$HOME/.local/share/bmo/deploy}/bin/bmo-agency\" coworker hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
