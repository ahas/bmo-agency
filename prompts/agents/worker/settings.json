{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "workflowSizeGuideline": "small",
  "disableClaudeAiConnectors": true,
  "skipDangerousModePermissionPrompt": true,
  "claudeMdExcludes": [
    "/home/*/.claude/CLAUDE.md"
  ],
  "skillOverrides": {
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "artifact-capabilities": "off",
    "keybindings-help": "off",
    "update-config": "off",
    "fewer-permission-prompts": "off",
    "loop": "off",
    "schedule": "off",
    "init": "off"
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "2147483647",
    "BASH_MAX_TIMEOUT_MS": "2147483647"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$BMO_SOURCE_DIR\" ] || [ -z \"$BMO_JOB_GUARD\" ] || sh -c \"$BMO_JOB_GUARD\" || true",
            "timeout": 86400
          }
        ]
      }
    ]
  }
}
